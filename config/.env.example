# AI Receptionist Automation - Environment Configuration
# Copy this file to .env and fill in your actual credentials

# ============================================================================
# 1. TELEPHONY & VOICE
# ============================================================================
# Twilio - Phone number & SIP trunk
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=your_messaging_service_sid

# VAPI - Voice AI Platform (primary voice agent)
VAPI_API_KEY=your_vapi_api_key
VAPI_ASSISTANT_ID=your_vapi_assistant_id
VAPI_WEBHOOK_URL=https://your-domain.com/webhooks/vapi

# Retell AI - Alternative voice agent (fallback)
RETELL_API_KEY=your_retell_api_key
RETELL_AGENT_ID=your_retell_agent_id

VOICE_PROVIDER=vapi
VOICE_FALLBACK_PROVIDER=retell
VOICE_VOICES=default,sales,support,urgent
VOICE_SALES_VOICE=default
VOICE_SUPPORT_VOICE=default
VOICE_URGENT_VOICE=default
MULTI_LANGUAGE=true
URGENCY_DETECTION=true
POLITE_CLOSING=true

# ============================================================================
# 2. AUTOMATION ENGINE
# ============================================================================
# n8n - Workflow automation
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook
N8N_API_KEY=your_n8n_api_key

TEST_MODE=true
AUTO_RESTART=true

# ============================================================================
# 3. CALENDAR & SCHEDULING
# ============================================================================
# Google Calendar
GOOGLE_CALENDAR_CREDENTIALS_PATH=./config/google_credentials.json
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
SEND_CALENDAR_invites=true

# ============================================================================
# 4. CRM & LEAD DATABASE
# ============================================================================
# Airtable (primary CRM)
AIRTABLE_API_KEY=your_airtable_api_key
AIRTABLE_BASE_ID=your_airtable_base_id
AIRTABLE_TABLE_LEADS=tbl_your_leads_table_id
AIRTABLE_TABLE_CALLS=tbl_your_calls_table_id

# Alternative: HubSpot
HUBSPOT_API_KEY=your_hubspot_api_key
LEAD_QUALIFICATION_SCORING=true
CALLER_RECOGNITION=true
IDENTITY_VERIFICATION_APPOINTMENTS=true
GOOGLE_CONTACTS_SYNC=true

# ============================================================================
# 5. NOTIFICATIONS
# ============================================================================
# Twilio SMS
TWILIO_MESSAGING_SERVICE_SID=your_messaging_service_sid

# SendGrid - Transactional email
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=receptionist@yourdomain.com

# Alternative: Resend
RESEND_API_KEY=your_resend_api_key

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/XXX/XXX
SLACK_CHANNEL=#reception-alerts
SLACK_BOT_TOKEN=xoxb-your-bot-token

# ============================================================================
# 6. TRANSCRIPTS & RECORDINGS
# ============================================================================
CALL_RECORDING=true
VOICEMAIL_TRANSCRIPTION=true
TRANSCRIPT_RETENTION_DAYS=30
TRANSCRIPT_SEARCHABLE=true
CALL_AI_SUMMARY=true

# ============================================================================
# 7. ANALYTICS & REPORTING
# ============================================================================
# Google Sheets (weekly/daily reports)
GOOGLE_SHEETS_ID=your_google_sheets_id

# Mixpanel (call analytics)
MIXPANEL_API_KEY=your_mixpanel_api_key
MIXPANEL_SECRET=your_mixpanel_secret

DAILY_REPORT_ENABLED=true
FILE_SHARING_ENABLED=true

# ============================================================================
# 8. APPLICATION SETTINGS
# ============================================================================
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=False
WEBHOOK_SECRET=your_webhook_secret_for_signature_verification

LOG_LEVEL=INFO
LOG_FILE=./logs/receptionist.log

# Timezone for scheduling
TIMEZONE=America/New_York

# Business hours (set to 24/7 per requirements)
BUSINESS_24_7=true
BUSINESS_HOURS_START=0
BUSINESS_HOURS_END=23
BUSINESS_DAYS=mon,tue,wed,thu,fri,sat,sun

# Role-based access
ROLE_BASED_ACCESS=true

# Multi-language IVR
MULTI_LANGUAGE_IVR=true

# Multi-channel
PHONE_ENABLED=true
WEB_CHAT_ENABLED=false
WEB_DASHBOARD_ENABLED=true
